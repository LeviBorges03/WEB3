@{
    ViewData["Title"] = "Perfil do Autor";
}

@section Styles {
    <link rel="stylesheet" href="~/css/biblioteca.css" />
    <style>
        /* Estilos baseados no Autor.css original (sem gradientes ou complexidades extras) */
        .biblioteca-header-local {
            margin-bottom: 30px;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .biblioteca-header-local h2 {
            color: var(--primary);
            border-bottom: 3px solid var(--accent);
            display: inline-block;
            padding-bottom: 5px;
            margin-top: 10px;
        }

        .voltar-link {
            text-decoration: none;
            color: var(--accent);
            font-weight: 600;
            font-size: 0.9rem;
            transition: color 0.2s;
        }

        .voltar-link:hover {
            color: var(--primary);
        }

        /* --- SEÇÃO DO AUTOR HERO (Simples) --- */
        .autor-hero {
            display: grid;
            grid-template-columns: 200px 1fr;
            gap: 40px;
            background: var(--white);
            padding: 40px;
            border-radius: 12px;
            box-shadow: var(--shadow);
            margin-bottom: 30px;
            align-items: center;
        }

        .autor-foto-grande {
            width: 200px;
            height: 200px;
            background: #e0e0e0;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 5px solid var(--white);
            box-shadow: var(--shadow);
        }

        .emoji-autor { font-size: 5rem; }

        .autor-essencial h1 {
            margin: 0;
            font-size: 2.5rem;
            color: var(--primary);
        }

        .autor-tagline {
            font-size: 1.1rem;
            color: var(--accent);
            margin: 5px 0 25px 0;
            font-style: italic;
        }

        .autor-metadados {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
        }

        .meta-dado {
            display: flex;
            flex-direction: column;
        }

        .rotulo {
            font-size: 0.75rem;
            text-transform: uppercase;
            color: #7f8c8d;
            letter-spacing: 1px;
        }

        .valor {
            font-weight: 600;
            color: var(--primary);
        }

        /* Obras Secao parecida com biblioteca.css grid expandido */
        .obras-secao {
            margin-top: 20px;
        }

        .obras-secao h3 {
            color: var(--primary);
            border-bottom: 3px solid var(--accent);
            display: inline-block;
            padding-bottom: 5px;
            margin-bottom: 20px;
        }

        /* Reuso e extensão do layout flexível dos livros-grid */
        .livros-grid-autor {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            padding-bottom: 40px;
        }

        /* Tornando os cards links clicáveis como no Livro */
        .livro-card-link {
            text-decoration: none;
            color: inherit;
        }

        /* Responsividade */
        @@media (max-width: 900px) {
            .livros-grid-autor { grid-template-columns: repeat(3, 1fr); }
        }
        @@media (max-width: 768px) {
            .autor-hero { grid-template-columns: 1fr; text-align: center; justify-items: center; }
            .autor-metadados { justify-content: center; }
        }
        @@media (max-width: 650px) {
            .livros-grid-autor { grid-template-columns: repeat(2, 1fr); }
        }
        @@media (max-width: 450px) {
            .livros-grid-autor { grid-template-columns: 1fr; }
        }
    </style>
}

@{
    // Variáveis simuladas para o Autor (preparação para Model)
    string nomeAutor = "Machado de Assis";
    string tagline = "Mestre do Realismo, Romancista, Contista e Poeta";
    string dataNascimento = "21 de Junho de 1839 (falecido em 1908)";
    string naturalidade = "Rio de Janeiro, Brasil";
    string generos = "Realismo, Romance, Conto";

    // Lista de obras usando cores hexadecimais em vez de imagens, conforme o padrão do catálogo.
    var obrasDoAutor = new List<dynamic>
    {
        new { Titulo = "Dom Casmurro", Genero = "Realismo", CorCapa = "#e74c3c" },
        new { Titulo = "A Moreninha", Genero = "Romantismo", CorCapa = "#8e44ad" },
        new { Titulo = "O Alquimista", Genero = "Ficção", CorCapa = "#f39c12" },
        new { Titulo = "Memórias Póstumas de Brás Cubas", Genero = "Realismo", CorCapa = "#3498db" }
    };
}

<div class="page-wrapper">
    <header class="biblioteca-header-local">
        <!-- Rota de volta para o Catálogo -->
        <a href="@Url.Action("Index", "Biblioteca")" class="voltar-link">
            ← Voltar para a Biblioteca
        </a>
        <h2>Perfil do Autor</h2>
    </header>

    <main class="perfil-container">
        <section class="autor-hero">
            <div class="autor-foto-grande">
                <i class="emoji-autor">✍️</i>
            </div>
            <div class="autor-essencial">
                <h1>@nomeAutor</h1>
                <p class="autor-tagline">@tagline</p>

                <div class="autor-metadados">
                    <div class="meta-dado">
                        <span class="rotulo">Nascimento:</span>
                        <span class="valor">@dataNascimento</span>
                    </div>
                    <div class="meta-dado">
                        <span class="rotulo">Naturalidade:</span>
                        <span class="valor">@naturalidade</span>
                    </div>
                    <div class="meta-dado">
                        <span class="rotulo">Gêneros:</span>
                        <span class="valor">@generos</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Reuso da info-secao da biblioteca.css original -->
        <section class="info-secao">
            <div class="info-box">
                <h3>Sobre o Autor</h3>
                <p>Joaquim Maria Machado de Assis é amplamente considerado como o maior nome da literatura brasileira. Nascido no Rio de Janeiro, sua vasta obra abrange romances, contos, poesias, crônicas e peças teatrais.</p>
                <p>Foi o principal expoente do Realismo no Brasil, com a publicação de "Memórias Póstumas de Brás Cubas" (1881). Sua narrativa é caracterizada por um profundo ceticismo, ironia refinada, pessimismo, e uma análise psicológica penetrante dos personagens.</p>
            </div>

            <div class="info-extras">
                <div class="extra-item">
                    <i class="icon">📚</i>
                    <span><strong>10+ Obras</strong> clássicas publicadas</span>
                </div>
                <div class="extra-item">
                    <i class="icon">🏆</i>
                    <span><strong>Fundador</strong> da Academia Brasileira de Letras</span>
                </div>
                <div class="extra-item">
                    <i class="icon">🌐</i>
                    <span><strong>Traduções</strong> em dezenas de idiomas</span>
                </div>
            </div>
        </section>

        <section class="obras-secao">
            <h3>Obras Publicadas</h3>

            <div class="livros-grid-autor">

                @foreach (var obra in obrasDoAutor)
                {
                    <a href="@Url.Action("Livro", "Biblioteca")" class="livro-card livro-card-link" style="width: 100%; flex: none;">
                        <div class="livro-capa-placeholder" style="background-color: @obra.CorCapa;">
                            <span class="genero-tag">@obra.Genero</span>
                        </div>
                        <div class="livro-info">
                            <h4>@obra.Titulo</h4>
                            <p>@nomeAutor</p>
                        </div>
                    </a>
                }

            </div>
        </section>
    </main>
</div>
