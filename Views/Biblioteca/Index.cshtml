@model List<Biblioteca.Models.Livro>

@{
    ViewData["Title"] = "Vitrine da Biblioteca";
}

@section Styles {
    <link rel="stylesheet" href="~/css/biblioteca.css" />
    <style>
        .autor-link-hover {
            transition: color 0.2s;
            cursor: pointer;
            color: #7f8c8d;
        }
        .autor-link-hover:hover {
            color: var(--primary);
            text-decoration: underline;
        }
    </style>
}

<div class="page-wrapper">

    <section class="biblioteca-header">
        <h2>Catálogo de Clássicos</h2>
    </section>

    <input type="text" id="pesquisaLivro" placeholder="Pesquisar livros..." oninput="filtrarLivros()" style="margin-bottom: 20px; width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #ccc;">

    <div class="carousel-container">
        @* Botão Esquerdo *@
        <button class="nav-btn left" onclick="scrollGrid(-1)">&#10094;</button>

        @* Grade de Livros com rolagem horizontal *@
        <div class="livros-grid" id="livrosGrid">
            @foreach (var item in Model)
            {
                <div class="livro-card" data-titulo="@item.Titulo">
                    <!-- Link clicável e script JS embutido no onclick -->
                    <a href="javascript:void(0);" onclick="abrirLivro('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.Titulo))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.Autor))', '@item.CorCapa', '@item.Genero', '@item.DataPublicacao.Year', '@item.NumPaginas')" class="livro-card-link" style="text-decoration: none; color: inherit; flex-grow: 1; display: flex; flex-direction: column;">
                        <div class="livro-capa-placeholder" style="background-color: @item.CorCapa;">
                            <span class="genero-tag">@item.Genero</span>
                            <div class="favorito-star" onclick="toggleFavorito(event, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.Titulo))')" style="position: absolute; top: 10px; right: 10px; font-size: 1.5rem; cursor: pointer; color: #ccc; z-index: 3;" data-titulo-star="@item.Titulo">⭐</div>
                        </div>
                        <div class="livro-info">
                            <h4>@item.Titulo</h4>

                            @* Elemento independente para abrir o Autor sem acionar o clique do livro usando event.stopPropagation() *@
                            <div onclick="abrirAutor(event, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.Autor))')">
                                <p class="autor-link-hover">@item.Autor</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>

        @* Botão Direito *@
        <button class="nav-btn right" onclick="scrollGrid(1)">&#10095;</button>
    </div>

    @* Botão elegante para expandir o catálogo *@
    <div class="expand-container">
        <button class="expand-btn" id="expandBtn" onclick="toggleExpand()" aria-label="Expandir catálogo" aria-expanded="false">
            <span id="expandBtnText">Ver todo o catálogo</span>
            <span id="expandBtnIcon" class="expand-icon">&#x25BC;</span>
        </button>
    </div>

    <section class="info-secao">
        <div class="info-box">
            <h3>Sobre a Nossa Biblioteca</h3>
            <p>Bem-vindo ao nosso acervo digital! Aqui você encontra uma seleção curada de obras para expandir seus horizontes. Nosso objetivo é facilitar o acesso à leitura de forma organizada e moderna.</p>
        </div>

        <div class="info-extras">
            <div class="extra-item">
                <i class="icon">📅</i>
                <span><strong>Total de Obras:</strong> @Model.Count títulos</span>
            </div>
            <div class="extra-item">
                <i class="icon">💡</i>
                <span><strong>Dica:</strong> Use as setas laterais para explorar os livros disponíveis.</span>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        // Função simples para rolar os livros lateralmente
        function scrollGrid(direction) {
            const grid = document.getElementById('livrosGrid');
            const scrollAmount = 300;
            grid.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
        }

        // Função para expandir o grid e mostrar todos os livros
        function toggleExpand() {
            const grid = document.getElementById('livrosGrid');
            const btn = document.getElementById('expandBtn');
            const navBtns = document.querySelectorAll('.nav-btn');
            const btnIcon = document.getElementById('expandBtnIcon');

            grid.classList.toggle('expandido');
            btnIcon.classList.toggle('rodado');

            navBtns.forEach(navBtn => navBtn.classList.toggle('escondido'));

            const btnText = document.getElementById('expandBtnText');
            if (grid.classList.contains('expandido')) {
                btn.setAttribute('aria-expanded', 'true');
                btn.setAttribute('aria-label', 'Recolher catálogo');
                btnText.innerText = "Recolher catálogo";
            } else {
                btn.setAttribute('aria-expanded', 'false');
                btn.setAttribute('aria-label', 'Expandir catálogo');
                btnText.innerText = "Ver todo o catálogo";
            }
        }

        // --- NOVAS FUNÇÕES: SPA-Like JS Data Transfer --- //
        function abrirLivro(titulo, autor, corCapa, genero, ano, paginas) {
            // Salvar no localStorage os dados que o Livro.cshtml precisa montar
            const livroData = { titulo, autor, corCapa, genero, ano, paginas };
            localStorage.setItem('livroAtual', JSON.stringify(livroData));

            // Redirecionar para a View Genérica
            window.location.href = '@Url.Action("Livro", "Biblioteca")';
        }

        function abrirAutor(event, nomeAutor) {
            // Previne que o clique na div do autor acione o "abrirLivro" (clique da âncora pai)
            event.stopPropagation();
            event.preventDefault();

            // Salvar dados do Autor (apenas o nome por enquanto, o JS de Autor vai popular o resto genérico)
            localStorage.setItem('autorAtual', nomeAutor);

            // Redirecionar para a View Genérica
            window.location.href = '@Url.Action("Autor", "Biblioteca")';
        }

        // Favoritos
        function getFavoritos() {
            return JSON.parse(localStorage.getItem('bibliotecaFavoritos') || '[]');
        }

        function setFavoritos(favoritos) {
            localStorage.setItem('bibliotecaFavoritos', JSON.stringify(favoritos));
        }

        function toggleFavorito(event, titulo) {
            event.stopPropagation();
            event.preventDefault();
            let favoritos = getFavoritos();
            if (favoritos.includes(titulo)) {
                favoritos = favoritos.filter(f => f !== titulo);
            } else {
                favoritos.push(titulo);
            }
            setFavoritos(favoritos);
            atualizarEstrelas();
        }

        function atualizarEstrelas() {
            const favoritos = getFavoritos();
            document.querySelectorAll('.favorito-star').forEach(star => {
                const titulo = star.getAttribute('data-titulo-star');
                if (favoritos.includes(titulo)) {
                    star.style.color = '#f1c40f'; // active
                } else {
                    star.style.color = '#ccc'; // inactive
                }
            });
        }

        // Pesquisa
        function filtrarLivros() {
            const searchInput = document.getElementById('pesquisaLivro').value;
            // Normaliza para remover acentos
            const term = searchInput.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

            document.querySelectorAll('.livro-card').forEach(card => {
                const titulo = card.getAttribute('data-titulo');
                if (!titulo) return;

                const tituloNormalized = titulo.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
                if (tituloNormalized.includes(term)) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            atualizarEstrelas();
        });
    </script>
}
